          <pose>0 0 0.125 0 0 0</pose>
          <geometry><box><size>0.26 0.12 0.25</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
        <visual name="marker_plate">
          <pose>0 -0.061 0.15 0 0 0</pose>
