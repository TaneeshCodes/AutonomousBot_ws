          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>/home/arc_aiml/AutonomousBot_ws/src/assessment_launch/textures/marker_0.png</albedo_map></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

